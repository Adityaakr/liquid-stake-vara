# Vale Protocol runs on Vara mainnet. Override the RPC endpoint if you run your own node.
VITE_VARA_RPC=wss://rpc.vara.network
# "mock" runs a fully simulated protocol; "gear" reads real native VARA balances from the chain.
VITE_ADAPTER=gear
# Vale Protocol staking program id (Sails). Leave empty until deployed: program writes stay simulated.
VITE_VALE_PROGRAM_ID=
