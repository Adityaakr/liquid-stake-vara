# Vale Protocol runs on Vara mainnet. Override the RPC endpoint if you run your own node.
VITE_VARA_RPC=wss://rpc.vara.network
# "gear" talks to the programs on Vara; "mock" runs a simulation in the browser.
VITE_ADAPTER=gear
# Program ids from deployments/mainnet.json (written by `pnpm deploy`).
VITE_KVARA_POOL=
VITE_USDC_TOKEN=
VITE_KUSDC_VAULT=
VITE_USDT_TOKEN=
VITE_KUSDT_VAULT=
