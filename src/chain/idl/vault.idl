
!@sails: 1.0.1

service Vft@0x3b5c6650d0dfc7a9 {
    events {
        Approval {
            owner: ActorId,
            spender: ActorId,
            value: U256,
        },
        Transfer {
            from: ActorId,
            to: ActorId,
            value: U256,
        },
    }
    functions {
        @query
        Allowance(owner: ActorId, spender: ActorId) -> U256;
        Approve(spender: ActorId, value: U256) -> bool throws VaultError;
        @query
        BalanceOf(account: ActorId) -> U256;
        @query
        Decimals() -> u8;
        @query
        Name() -> String;
        @query
        Symbol() -> String;
        @query
        TotalSupply() -> U256;
        Transfer(to: ActorId, value: U256) -> bool throws VaultError;
        TransferFrom(from: ActorId, to: ActorId, value: U256) -> bool throws VaultError;
    }
    types {
        enum VaultError {
            Paused,
            ZeroAddress,
            ZeroAmount,
            BelowMinimum {
                min: U256,
            },
            InsufficientShares,
            InsufficientBalance,
            InsufficientAllowance,
            /// The vault's distributable assets cannot cover this payout; nothing changed.
            InsufficientReserve {
                available: U256,
            },
            Unauthorized,
            Overflow,
            BadConfig,
            UnbondNotFound,
            UnbondNotReady {
                claimable_at: u64,
            },
            /// The underlying token rejected the transfer (allowance, balance, paused).
            TokenRejected(String),
            /// The cross-program call failed to complete (timeout, transport, panic).
            TokenCall(String),
            /// The message carried less gas than the async flow needs; nothing was moved.
            NotEnoughGas {
                required: u64,
            },
            /// The token did not reply in time. The transfer may or may not have happened: the call is
            /// recorded under this id and the admin settles it with `resolve_unconfirmed`.
            Unconfirmed {
                id: u64,
            },
            /// The session key acting for the owner has expired.
            SessionExpired,
            /// The session key acting for the owner may not perform this action.
            SessionNotAllowed,
            /// Session key, duration or action list is invalid, or no matching proposal exists.
            BadSession,
        }
    }
}

service Vault@0x4b929d819ead88bc {
    events {
        AdminTransferred {
            from: ActorId,
            to: ActorId,
        },
        Claimed {
            owner: ActorId,
            id: u64,
            assets: U256,
        },
        ConfigChanged {
            instant_fee_bps: u32,
            unbond_period_secs: u64,
            vesting_period_secs: u64,
        },
        Deposited {
            owner: ActorId,
            assets: U256,
            shares: U256,
            rate: U256,
        },
        FeesCollected {
            to: ActorId,
            assets: U256,
        },
        Paused {
            by: ActorId,
        },
        Redeemed {
            owner: ActorId,
            shares: U256,
            assets: U256,
            fee: U256,
            rate: U256,
        },
        Resumed {
            by: ActorId,
        },
        RewardsFunded {
            from: ActorId,
            assets: U256,
            holdings: U256,
            vesting_ends_at: u64,
        },
        SessionAccepted {
            owner: ActorId,
            key: ActorId,
            expires_at: u64,
        },
        SessionProposed {
            owner: ActorId,
            key: ActorId,
            expires_at: u64,
        },
        SessionRevoked {
            owner: ActorId,
        },
        UnbondRequested {
            owner: ActorId,
            id: u64,
            shares: U256,
            assets: U256,
            claimable_at: u64,
        },
        UnconfirmedRecorded {
            id: u64,
            owner: ActorId,
            kind: UnconfirmedKind,
            assets: U256,
        },
        UnconfirmedResolved {
            id: u64,
            delivered: bool,
        },
    }
    functions {
        AcceptSession(owner: ActorId) -> Result<Session, VaultError>;
        Claim(id: u64) -> Result<U256, VaultError>;
        CollectFees(to: ActorId) -> Result<U256, VaultError>;
        CreateSession(key: ActorId, duration_secs: u64, actions: [SessionAction]) -> Result<Session, VaultError>;
        Deposit(assets: U256) -> Result<U256, VaultError>;
        FundRewards(assets: U256) -> Result<U256, VaultError>;
        @query
        Info() -> VaultInfo;
        Pause() -> Result<bool, VaultError>;
        @query
        PendingSession(owner: ActorId) -> Option<Session>;
        @query
        Position(account: ActorId) -> Position;
        @query
        PreviewDeposit(assets: U256) -> U256;
        @query
        PreviewRedeem(shares: U256) -> RedeemPreview;
        @query
        Rate() -> U256;
        Redeem(shares: U256) -> Result<RedeemPreview, VaultError>;
        RequestUnbond(shares: U256) -> Result<Unbond, VaultError>;
        ResolveUnconfirmed(id: u64, delivered: bool) -> Result<bool, VaultError>;
        Resume() -> Result<bool, VaultError>;
        RevokeSession() -> bool;
        @query
        Session(owner: ActorId) -> Option<Session>;
        @query
        SessionOwner(key: ActorId) -> Option<ActorId>;
        SetConfig(instant_fee_bps: u32, unbond_period_secs: u64, vesting_period_secs: u64) -> Result<bool, VaultError>;
        TransferAdmin(to: ActorId) -> Result<bool, VaultError>;
        @query
        Unbonds(account: ActorId) -> [Unbond];
        @query
        Unconfirmed() -> [Unconfirmed];
    }
    types {
        struct Position {
            shares: U256,
            assets: U256,
        }
        struct RedeemPreview {
            assets: U256,
            fee: U256,
            net: U256,
        }
        /// A session key registered by an owner: messages signed by `key` act for the owner until
        /// `expires_at`. Payouts always go to the owner, never to the key. A session is proposed by
        /// the owner and only takes effect once the key itself accepts it, so nobody can bind an
        /// address they do not control.
        struct Session {
            key: ActorId,
            expires_at: u64,
            actions: [SessionAction],
        }
        /// Actions a session key may perform for its owner.
        enum SessionAction {
            Deposit,
            Redeem,
            Unbond,
            Claim,
        }
        struct Unbond {
            id: u64,
            shares: U256,
            assets: U256,
            requested_at: u64,
            claimable_at: u64,
        }
        struct Unconfirmed {
            id: u64,
            owner: ActorId,
            kind: UnconfirmedKind,
            assets: U256,
        }
        /// A token call whose reply never arrived. `Deposit` and `Rewards` pulled tokens that are not
        /// on the books; `Payout` sent tokens the books already count as paid.
        enum UnconfirmedKind {
            Deposit,
            Rewards,
            Payout,
        }
        enum VaultError {
            Paused,
            ZeroAddress,
            ZeroAmount,
            BelowMinimum {
                min: U256,
            },
            InsufficientShares,
            InsufficientBalance,
            InsufficientAllowance,
            /// The vault's distributable assets cannot cover this payout; nothing changed.
            InsufficientReserve {
                available: U256,
            },
            Unauthorized,
            Overflow,
            BadConfig,
            UnbondNotFound,
            UnbondNotReady {
                claimable_at: u64,
            },
            /// The underlying token rejected the transfer (allowance, balance, paused).
            TokenRejected(String),
            /// The cross-program call failed to complete (timeout, transport, panic).
            TokenCall(String),
            /// The message carried less gas than the async flow needs; nothing was moved.
            NotEnoughGas {
                required: u64,
            },
            /// The token did not reply in time. The transfer may or may not have happened: the call is
            /// recorded under this id and the admin settles it with `resolve_unconfirmed`.
            Unconfirmed {
                id: u64,
            },
            /// The session key acting for the owner has expired.
            SessionExpired,
            /// The session key acting for the owner may not perform this action.
            SessionNotAllowed,
            /// Session key, duration or action list is invalid, or no matching proposal exists.
            BadSession,
        }
        struct VaultInfo {
            underlying: ActorId,
            admin: ActorId,
            name: String,
            symbol: String,
            decimals: u8,
            /// Assets per share scaled by 1e18: distributable assets over shares, now.
            rate: U256,
            /// Annualised release rate of the rewards currently vesting, over distributable assets.
            /// Zero once the current tranche has fully vested.
            apy_bps: u32,
            instant_fee_bps: u32,
            unbond_period_secs: u64,
            vesting_period_secs: u64,
            total_shares: U256,
            /// Assets owed to share holders: the distributable amount.
            total_assets: U256,
            /// Underlying the vault physically holds (deposits, rewards, fees, unbonds).
            holdings: U256,
            /// Holdings minus fees, unbonds and rewards still vesting.
            distributable: U256,
            /// Rewards not yet released.
            locked_rewards: U256,
            /// When the current tranche is fully vested (0 when nothing is vesting).
            vesting_ends_at: u64,
            fees_accrued: U256,
            /// Fees of redeems whose payout is still in flight; collectable once it landed.
            fees_pending: U256,
            unbonding_total: U256,
            min_deposit: U256,
            paused: bool,
            /// Token calls waiting for the admin to settle them.
            unconfirmed: u32,
        }
    }
}

program Vault {
    constructors {
        New(underlying: ActorId, name: String, symbol: String, decimals: u8, instant_fee_bps: u32, unbond_period_secs: u64, vesting_period_secs: u64, initial_rate: U256);
    }
    services {
        Vft@0x3b5c6650d0dfc7a9,
        Vault@0x4b929d819ead88bc,
    }
}
